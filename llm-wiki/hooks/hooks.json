{
  "description": "LLM Wiki: provides the wiki location and table of contents in registered repositories, and auto-extracts candidates at session end",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/llm_wiki.ts\" hook-session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/llm_wiki.ts\" hook-session-end || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
